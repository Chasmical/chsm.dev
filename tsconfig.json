{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }, { "name": "typescript-plugin-css-modules" }],
    "paths": {
      "@components/*": ["./components/*"],
      "@static/*": ["./public/*"],
      "@api/*": ["./app/api/*"],
      "@app/*": ["./app/*"],
      "@lib/*": ["./lib/*"],
      "@site/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "app/api/.private/**/*.ts",
    "eslint.config.js",
    ".prettierrc.mjs",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
